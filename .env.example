# Copie este arquivo para .env na raiz do projeto (c:\Users\alesi\area+\.env)
# e preencha com as credenciais do seu Console do Firebase (https://console.firebase.google.com/)

VITE_FIREBASE_API_KEY=AIzaSySuaChaveAqui
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxx

# E-mail de Administrador autorizado para o Painel CRM / WhatsApp
# Apenas contas com este e-mail (ou contendo admin) terão permissão de acesso ao CRM
